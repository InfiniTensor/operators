#include "../../../devices/bang/common_bang.h"
#include "../../utils.h"
#include "bang.h"
#include "bang_device_functions.h"
#include "cnrt.h"
#include "rotary_embedding_bang.h"

const int SRC_MAX_SIZE = 1024 * 8;//8 = 256/32
__nram__ char nram_buffer[NRAM_MAX_SIZE];

template<typename Tdata>
__mlu_device__ void process_chunk(
    Tdata *y, const float *sin_table, const float *cos_table,
    float *srcSin, float *srcCos, float *sin0, float *cos0,
    float *sin1, float *cos1, float *tmpa, float *tmpb,
    Tdata *srca, Tdata *srcb, Tdata *src,
    int src_index, int dest_index,
    int chunk_size, int half_chunk,
    int segsize, int segsize_table,
    int srcStrideL, int destStrideL, int srcStrideW, int destStrideW,
    int srcStrideL_table, int destStrideL_table) {
    // Load sin/cos data
    __memcpy(srcSin, sin_table + src_index, chunk_size * sizeof(float), GDRAM2NRAM);
    __memcpy(sin0, srcSin, segsize_table, NRAM2NRAM, destStrideL_table, srcStrideL_table, chunk_size);
    __memcpy(sin1, srcSin + 1, segsize_table, NRAM2NRAM, destStrideL_table, srcStrideL_table, chunk_size);

    __memcpy(srcCos, cos_table + src_index, chunk_size * sizeof(float), GDRAM2NRAM);
    __memcpy(cos0, srcCos, segsize_table, NRAM2NRAM, destStrideL_table, srcStrideL_table, chunk_size);
    __memcpy(cos1, srcCos + 1, segsize_table, NRAM2NRAM, destStrideL_table, srcStrideL_table, chunk_size);

    // Load input data
    __memcpy(src, y + dest_index, chunk_size * sizeof(Tdata), GDRAM2NRAM);
    __memcpy(srca, src, segsize, NRAM2NRAM, destStrideL, srcStrideL, chunk_size);
    __memcpy(srcb, src + 1, segsize, NRAM2NRAM, destStrideL, srcStrideL, chunk_size);

    // Convert to float and compute RoPE
    __bang_half2float(tmpa, srca, half_chunk);
    __bang_half2float(tmpb, srcb, half_chunk);

    __bang_mul(cos0, tmpa, cos0, half_chunk);
    __bang_mul(sin0, tmpb, sin0, half_chunk);
    __bang_sub(cos0, cos0, sin0, half_chunk);

    __bang_mul(sin1, tmpa, sin1, half_chunk);
    __bang_mul(cos1, tmpb, cos1, half_chunk);
    __bang_add(cos1, sin1, cos1, half_chunk);

    // Convert back and store
    __bang_float2half_dn(srca, cos0, half_chunk);
    __bang_float2half_dn(srcb, cos1, half_chunk);

    __memcpy(src, srca, segsize, NRAM2NRAM, destStrideW, srcStrideW, chunk_size);
    __memcpy(src + 1, srcb, segsize, NRAM2NRAM, destStrideW, srcStrideW, chunk_size);
    __memcpy(y + dest_index, src, chunk_size * sizeof(Tdata), NRAM2GDRAM);
}

template<typename Tdata>
__mlu_global__ void RoPE(Tdata *y, const uint64_t *pos_ids, const float *sin_table,
                         const float *cos_table, int seqlen, int nhead, int table_dim, int y_stride_seqlen, int y_stride_nhead) {
    const int maxNum = SRC_MAX_SIZE / sizeof(float);

    // Key variables that determine execution path
    const bool use_pos_ids_buffer = (seqlen < maxNum);
    const bool large_dim = (table_dim >= maxNum);
    const int chunk_size = large_dim ? 2 * maxNum : table_dim;
    const int half_chunk = chunk_size / 2;

    // Common stride configurations
    const int segsize = sizeof(Tdata);
    const int srcStrideL = 2 * sizeof(Tdata);
    const int destStrideL = 1 * sizeof(Tdata);
    const int srcStrideW = 1 * sizeof(Tdata);
    const int destStrideW = 2 * sizeof(Tdata);
    const int segsize_table = sizeof(float);
    const int srcStrideL_table = 2 * sizeof(float);
    const int destStrideL_table = 1 * sizeof(float);

    // Task distribution
    const int othersize = seqlen * nhead;
    const int remainT = othersize % taskDim;
    const int stepEasy = (othersize - remainT) / taskDim;
    const int stepHard = stepEasy + 1;
    const int step = (taskId < remainT ? stepHard : stepEasy);
    const int indStart = (taskId < remainT ? taskId * stepHard : (taskId - remainT) * stepEasy + remainT * stepHard);

    // NRAM buffer allocation
    char *nram_buffer1 = use_pos_ids_buffer ? (nram_buffer + seqlen * sizeof(uint64_t)) : nram_buffer;

    // Setup position IDs
    uint64_t *srcP = nullptr;
    if (use_pos_ids_buffer) {
        srcP = (uint64_t *) nram_buffer;
        __memcpy(srcP, pos_ids, seqlen * sizeof(uint64_t), GDRAM2NRAM);
    }

    // Main processing buffers
    float *srcSin = (float *) nram_buffer1;
    float *srcCos = srcSin + chunk_size;
    float *sin0 = srcCos + chunk_size;
    float *cos0 = sin0 + 3 * half_chunk;
    float *sin1 = cos0 + 3 * half_chunk;
    float *cos1 = sin1 + 3 * half_chunk;
    float *tmpa = cos1 + 3 * half_chunk;
    float *tmpb = tmpa + half_chunk;

    Tdata *srca = (Tdata *) (tmpb + half_chunk);
    Tdata *srcb = srca + half_chunk;
    Tdata *src = srcb + 3 * half_chunk;

    // Main processing loop
    for (int i = indStart; i < indStart + step; i++) {
        // Calculate y index
        int indd = 0;
        int indi = i;
        indd += (indi % nhead) * y_stride_nhead;
        indi /= nhead;
        indd += (indi % seqlen) * y_stride_seqlen;

        // Get position index
        uint64_t pos_idx = use_pos_ids_buffer ? srcP[(indi % seqlen)] : pos_ids[(indi % seqlen)];
        int index = pos_idx * table_dim;

        // Determine processing parameters
        int current_chunk_size;
        int current_half_chunk;
        int src_offset;
        int dest_offset;
        int repeat_count = 1;
        bool process_remainder = false;

        if (large_dim) {
            int remain = table_dim % chunk_size;
            repeat_count = (table_dim - remain) / chunk_size;
            process_remainder = (remain != 0);
        }

        // Process main chunks
        for (int s = 0; s < repeat_count; s++) {
            current_chunk_size = chunk_size;
            current_half_chunk = half_chunk;
            src_offset = index + s * chunk_size;
            dest_offset = indd + s * chunk_size;

            process_chunk<Tdata>(
                y, sin_table, cos_table,
                srcSin, srcCos, sin0, cos0, sin1, cos1, tmpa, tmpb,
                srca, srcb, src,
                src_offset, dest_offset,
                current_chunk_size, current_half_chunk,
                segsize, segsize_table,
                srcStrideL, destStrideL, srcStrideW, destStrideW,
                srcStrideL_table, destStrideL_table);
        }

        // Process remainder if needed
        if (process_remainder) {
            int remain = table_dim % chunk_size;
            current_chunk_size = remain;
            current_half_chunk = remain / 2;
            src_offset = index + repeat_count * chunk_size;
            dest_offset = indd + repeat_count * chunk_size;

            process_chunk<Tdata>(
                y, sin_table, cos_table,
                srcSin, srcCos, sin0, cos0, sin1, cos1, tmpa, tmpb,
                srca, srcb, src,
                src_offset, dest_offset,
                current_chunk_size, current_half_chunk,
                segsize, segsize_table,
                srcStrideL, destStrideL, srcStrideW, destStrideW,
                srcStrideL_table, destStrideL_table);
        }
    }
}

template<typename Tdata>
void RoPEUnion(cnrtQueue_t queue, void *y, void const *pos_ids, void const *sin_table, void const *cos_table, int y_stride_seqlen, int y_stride_nhead, int seqlen, int nhead, int table_dim) {

    auto pos_ = reinterpret_cast<uint64_t const *>(pos_ids);
    auto sin_ = reinterpret_cast<float const *>(sin_table);
    auto cos_ = reinterpret_cast<float const *>(cos_table);
    auto t_ = reinterpret_cast<Tdata *>(y);

    cnrtDim3_t k_dim;
    cnrtFunctionType_t k_type;

    k_dim.x = 4;
    k_dim.y = 1;
    k_dim.z = 1;
    k_type = CNRT_FUNC_TYPE_UNION1;

    RoPE<Tdata><<<k_dim, k_type, queue>>>(t_, pos_, sin_, cos_, seqlen, nhead, table_dim, y_stride_seqlen, y_stride_nhead);
    cnrtQueueSync(queue);
}

void RoPE_bang_f16(RoPEBangDescriptor_t desc, void *t,
                   void const *pos_ids,
                   void const *sin_table,
                   void const *cos_table, void *stream) {
    auto queue = reinterpret_cast<cnrtQueue_t>(stream);
    int seqlen = static_cast<int>(desc->seq_len);
    int nhead = static_cast<int>(desc->nhead);
    int table_dim = static_cast<int>(desc->dim);
    auto y_stride_seqlen = desc->stride_0;
    auto y_stride_nhead = desc->stride_1;

    RoPEUnion<half>(queue, t, pos_ids, sin_table, cos_table, y_stride_seqlen, y_stride_nhead, seqlen, nhead, table_dim);
}

infiniopStatus_t bangRoPE(RoPEBangDescriptor_t desc,
                          void *workspace,
                          uint64_t workspace_size,
                          void *t,
                          void const *pos_ids,
                          void const *sin_table,
                          void const *cos_table,
                          void *stream) {
    if (cnrtSetDevice(desc->device_id) != cnrtSuccess) {
        return STATUS_BAD_DEVICE;
    }
    if (t == nullptr || pos_ids == nullptr || sin_table == nullptr || cos_table == nullptr)
        return STATUS_BAD_PARAM;

    if (dtype_eq(desc->dtype, F16)) {
        RoPE_bang_f16(desc, t,
                      pos_ids,
                      sin_table,
                      cos_table, stream);
    } else {
        return STATUS_BAD_TENSOR_DTYPE;
    }

    return STATUS_SUCCESS;
}
